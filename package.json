{
  "name": "concurrence-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/tools-gate --noEmit && tsc -p api --noEmit",
    "demo:gen": "tsx api/demo/generateGate.ts",
    "demo": "tsx api/demo/runGate.ts",
    "provision": "tsx api/provisioning/provision.ts",
    "demo:pods": "tsx api/demo/livePods.ts",
    "dev": "concurrently -n api,web \"tsx api/server.ts\" \"vite\"",
    "build": "vite build",
    "push:prompts": "tsx api/provisioning/pushPrompts.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@google/adk": "^1.6.0",
    "@google/genai": "^2.17.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
